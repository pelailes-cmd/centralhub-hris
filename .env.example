# Project settings → API. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: invitations, recovery, rate limits, private file streaming, setup.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random secret of at least 32 characters. Never commit the real value.
AUTH_RATE_LIMIT_PEPPER=
# Fictional preview is allowed only in next dev with Supabase keys absent.
ENABLE_DEMO=true
ALLOW_DEVELOPMENT_SEED=false
DEMO_ACCOUNT_PASSWORD=
